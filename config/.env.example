# Copiar este archivo como .env y completar con los datos reales.
# .env NUNCA se sube a git (ver .gitignore) — hay que crearlo a mano en cada
# servidor/computadora (ver doc/Idea.md > INSTALACIÓN).

APP_ENV=production

# APP_URL es la ÚNICA fuente de verdad de dónde vive el sitio. Si incluye una
# subcarpeta, TODO el sitio (assets, links, redirecciones) se ajusta solo —
# no hay que tocar código ni agregar otra variable (ver BASE_PATH en
# config/config.php). Mientras APP_URL tenga subcarpeta también se agrega
# noindex/nofollow automáticamente, para no indexar una URL de demo temporal.
#   dominio final, en la raíz:      APP_URL=https://tudominio.com.ar
#   demo temporal, en subcarpeta:   APP_URL=https://demos.aifosinformatica.com.ar/informatica
APP_URL=https://demos.aifosinformatica.com.ar/informatica
APP_TIMEZONE=America/Argentina/Buenos_Aires

# En local se puede usar root directamente. En producción, crear un usuario
# de MySQL específico para esta base (no usar root) — ver doc/Idea.md > INSTALACIÓN.
DB_HOST=localhost
DB_NAME=u736172797_informatica
DB_USER=u736172797_inform_adm
DB_PASS=Hlvb.2021!Ai

# Sistema de turnos: login de clientes con Google (ver doc/Idea.md > SISTEMA DE TURNOS).
# Se crean en Google Cloud Console > APIs & Services > Credentials > OAuth Client ID
# (tipo "Web application"), con Authorized redirect URI = <APP_URL>/turnos-callback.php
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envío de mails (aviso de turno nuevo al admin y confirmación al cliente) por
# SMTP de Gmail. SMTP_USER es la cuenta de Gmail; SMTP_PASS es una "contraseña
# de aplicación" (Cuenta de Google > Seguridad > Verificación en 2 pasos >
# Contraseñas de aplicaciones), NO la contraseña normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Servicio Técnico Caseros
